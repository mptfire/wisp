# DRAFT ONLY — not a valid Zapstore manifest. The fields below follow an
# invented schema; Zapstore's zsp CLI expects repository, pubkey (npub),
# name, summary, description, license, tags, release_filter, match.
# Replace this file with `zsp init` output before any submission.
name: Wisp
short-description: Private Nostr DMs, zaps, and a self-custodial Lightning wallet
author: mptfire
repository: https://github.com/mptfire/wisp
tags:
  - nostr
  - lightning
  - bitcoin
  - android

general:
  description: |
    Wisp is a native Android Nostr client with private DMs (NIP-17),
    zaps, and a self-custodial Lightning wallet (Spark SDK). This is the
    community fork build carrying extra security hardening on top of
    upstream: DM seal authentication, fail-closed mnemonic validation,
    zap receipt consistency checks, SSRF guards, and BOLT-11 checksum
    verification.
  release-notes: dist/release-notes.md

platforms:
  android:
    package: de.rtard.wisp
    min-api: 26

versions:
  1.3.0-fork.1:
    version-code: 92
    apk: https://wisp.rtard.de/download/wisp-1.3.0-fork.1.apk
    sha256: see the GitHub Release SHA256SUMS (filled at publish time)
